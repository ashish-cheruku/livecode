# ============================================================
# CompanyInsights.AI — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# API base URL — only needed when NOT using the Vite dev proxy
# (i.e. for production builds pointing at a remote backend).
# During local development the vite.config.ts proxy handles /api → localhost:8000.
# VITE_API_BASE_URL=https://your-backend-domain.com
